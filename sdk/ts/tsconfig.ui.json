{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [],
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@persona/extension"
  },
  "include": ["src/ui.ts", "src/jsx-runtime.ts", "src/jsx-dev-runtime.ts", "typechecks/native.tsx"]
}
