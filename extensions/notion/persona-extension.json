{
  "manifest_version": 1,
  "id": "notion",
  "name": "Notion 笔记",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "在 Persona 里找自己共享给 Notion integration 的页面，读标题、段落和待办，继续整理笔记；向指定页面追加笔记/待办或新建页面前在手机上确认。integration secret 加密存在 hub。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/notion/README.md",
  "tags": ["Notion", "笔记", "知识库", "待办"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/notion-linux-amd64",
      "linux-arm64": "bin/notion-linux-arm64",
      "darwin-arm64": "bin/notion-darwin-arm64",
      "darwin-amd64": "bin/notion-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{
      "id": "notion", "name": "Notion", "capabilities": ["status", "tools", "actions"],
      "hosts": ["notion.so"], "agent_tools": ["notion_*"],
      "confirm_always": ["notion_append", "notion_create"]
    }],
    "ui": [{"id": "pages", "title": "笔记", "placement": "nav_page", "icon": "doc"}]
  },
  "secrets": [{
    "name": "integration_secret", "title": "Notion Integration Secret",
    "description": "在 Notion 的 My connections 中创建 integration，并只把需要的页面分享给它；token 只发往 api.notion.com",
    "required": true
  }],
  "permissions": {"network": ["api.notion.com"]}
}
