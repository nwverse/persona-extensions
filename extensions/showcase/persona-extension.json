{
  "manifest_version": 1,
  "id": "showcase",
  "name": "组件展示",
  "version": "0.1.0",
  "description": "扩展界面的每一种组件、每一种状态各一页：文字、数字、进度、行、按钮、链接、输入、图表、Markdown、表格、空状态、加载中；列表的搜索 / 筛选 / 加载更多，列表 → 详情 → 编辑 → 返回，invalidate；外加一张总览卡片、一个小组件和两个快捷指令。给写扩展的人看效果，也给各端做截图对齐。纯本地数据，不出网、不要密钥。",
  "publisher": "nwverse",
  "tags": ["示例", "开发"],
  "engines": {"extension_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/showcase-linux-amd64",
      "linux-arm64": "bin/showcase-linux-arm64",
      "darwin-amd64": "bin/showcase-darwin-amd64",
      "darwin-arm64": "bin/showcase-darwin-arm64"
    }
  },
  "contributes": {
    "ui": [
      {"id": "showcase", "title": "组件展示", "placement": "nav_page", "icon": "star"},
      {"id": "showcase-card", "title": "组件展示", "placement": "overview_card", "opens": "showcase"},
      {"id": "showcase-widget", "title": "组件展示", "placement": "widget",
       "families": ["small", "medium", "large", "accessory_circular", "accessory_rectangular", "accessory_inline"],
       "refresh_minutes": 60, "opens": "showcase"}
    ],
    "shortcuts": [
      {"id": "showcase-echo", "title": "组件展示：说一句", "description": "把你写的话原样说回来",
       "params": [{"name": "text", "title": "说什么", "kind": "text", "required": true}], "ui": "showcase"},
      {"id": "showcase-count", "title": "组件展示：数一数", "description": "按单位数到一个数，回一张结果卡片",
       "params": [
         {"name": "n", "title": "数到几", "kind": "number", "required": true},
         {"name": "unit", "title": "单位", "kind": "choice", "choices": [{"value": "apple", "title": "苹果"}, {"value": "star", "title": "星星"}]},
         {"name": "loud", "title": "大声", "kind": "toggle"}
       ]}
    ]
  }
}
