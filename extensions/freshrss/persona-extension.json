{
  "manifest_version": 1,
  "id": "freshrss",
  "name": "FreshRSS 阅读",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "在 Persona 中阅读 FreshRSS 未读和收藏文章、查看订阅，确认后把单篇文章标记已读。API 用户名和专用 API 密码加密保存在 hub，仅用于 HTTPS 登录交换；不批量标记已读、不管理订阅、不抓取原文媒体。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/freshrss/README.md",
  "tags": ["FreshRSS", "RSS", "稍后阅读", "自托管"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/freshrss-linux-amd64",
      "linux-arm64": "bin/freshrss-linux-arm64",
      "darwin-arm64": "bin/freshrss-darwin-arm64",
      "darwin-amd64": "bin/freshrss-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{
      "id": "freshrss", "name": "FreshRSS", "capabilities": ["status", "tools", "actions"],
      "hosts": [], "agent_tools": ["freshrss_*"],
      "confirm_always": ["freshrss_mark_read"]
    }],
    "ui": [{"id": "reading", "title": "FreshRSS 阅读", "placement": "nav_page", "icon": "doc"}]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "instance_url": {"type": "string", "title": "FreshRSS API 地址", "description": "例如 https://freshrss.example.com/api/greader.php；仅本机允许 HTTP", "format": "uri"}
    }
  },
  "secrets": [{
    "name": "api_username", "title": "FreshRSS 用户名",
    "description": "用于 Google Reader ClientLogin 的 FreshRSS 用户名；仅用于登录交换",
    "required": true
  }, {
    "name": "api_password", "title": "FreshRSS API 密码",
    "description": "FreshRSS API 页面重置的专用 API 密码，不是普通登录密码；只通过 POST 发往配置的实例",
    "required": true
  }],
  "permissions": {"network": []}
}
