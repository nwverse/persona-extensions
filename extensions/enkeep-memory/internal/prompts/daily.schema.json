{"type":"object","additionalProperties":false,"required":["summary","facts","practices","knowledge","mentions","assertions"],
 "properties":{
  "summary":{"type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["text","evidence"],
    "properties":{"text":{"type":"string"},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}}}}},
  "facts":{"type":"array","items":{"$ref":"#/$defs/item"}},
  "practices":{"type":"array","items":{"$ref":"#/$defs/item"}},
  "knowledge":{"type":"array","items":{"$ref":"#/$defs/item"}},
  "mentions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["surface","type","n"],
    "properties":{"surface":{"type":"string"},"type":{"type":"string"},"n":{"type":"integer"},"id":{"type":"string"}}}},
  "assertions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["s","p","o","evidence","confidence"],
    "properties":{"s":{"type":"string"},"p":{"type":"string"},"o":{"type":"string"},
      "attrs":{"type":"object","additionalProperties":{"type":"string"}},"when":{"type":"string"},
      "evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},
      "confidence":{"type":"string","enum":["high","medium","low"]}}}}},
 "$defs":{
  "evidence":{"type":"object","additionalProperties":false,"required":["n","quote"],
    "properties":{"n":{"type":"integer"},"quote":{"type":"string"},"speaker":{"type":"string"}}},
  "item":{"type":"object","additionalProperties":false,"required":["claim","evidence","confidence"],
    "properties":{"claim":{"type":"string"},"about":{"type":"string"},"when":{"type":"string"},"scope":{"type":"string"},
      "evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},
      "confidence":{"type":"string","enum":["high","medium","low"]}}}}}
