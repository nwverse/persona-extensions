{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "jsx": "react-jsx", "jsxImportSource": "@persona/extension",
    "types": ["node", "bun"], "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["tests/invalid.tsx"]
}
