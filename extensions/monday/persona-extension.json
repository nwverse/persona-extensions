{
  "manifest_version": 1,
  "id": "monday",
  "name": "monday 工作项",
  "version": "0.1.0",
  "description": "在 Persona 里处理 monday.com 个人工作项：浏览可访问的 boards 和 items，阅读状态与列值；创建 item 或更新已有状态 label 前在手机上确认。个人 API token 加密存在 hub，不执行任意 GraphQL，不创建 label，不管理 board。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/monday/README.md",
  "tags": ["monday", "工作项", "boards", "团队协作"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/monday-linux-amd64",
      "linux-arm64": "bin/monday-linux-arm64",
      "darwin-arm64": "bin/monday-darwin-arm64",
      "darwin-amd64": "bin/monday-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{
      "id": "monday", "name": "monday", "capabilities": ["status", "tools", "actions"],
      "hosts": ["api.monday.com"], "agent_tools": ["monday_*"],
      "confirm_always": ["monday_create_item", "monday_update_status"]
    }],
    "ui": [{"id": "items", "title": "monday 工作项", "placement": "nav_page", "icon": "check"}]
  },
  "configuration": {"type": "object", "properties": {}},
  "secrets": [{
    "name": "api_token", "title": "monday 个人 V2 API token",
    "description": "在 monday 的 Developer Center 获取；只通过 Authorization 发往固定的 api.monday.com",
    "required": true
  }],
  "permissions": {"network": ["api.monday.com"]}
}
