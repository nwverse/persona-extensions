{
  "manifest_version": 1,
  "id": "jellyfin",
  "name": "Jellyfin 继续观看",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "在 Persona 中查看 Jellyfin 当前用户的继续观看、搜索电影和剧集、阅读媒体信息与播放进度，确认后收藏或取消收藏。API key 加密保存在 hub；自托管服务要求 HTTPS，不自动播放或下载媒体、不修改播放进度或权限。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/jellyfin/README.md",
  "tags": ["Jellyfin", "电影", "剧集", "自托管"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/jellyfin-linux-amd64",
      "linux-arm64": "bin/jellyfin-linux-arm64",
      "darwin-arm64": "bin/jellyfin-darwin-arm64",
      "darwin-amd64": "bin/jellyfin-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{
      "id": "jellyfin", "name": "Jellyfin", "capabilities": ["status", "tools", "actions"],
      "hosts": [], "agent_tools": ["jellyfin_*"],
      "confirm_always": ["jellyfin_set_favorite"]
    }],
    "ui": [{"id": "watching", "title": "Jellyfin 继续观看", "placement": "nav_page", "icon": "doc"}]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "instance_url": {"type": "string", "title": "Jellyfin 实例地址", "description": "例如 https://jellyfin.example.com；仅本机允许 HTTP", "format": "uri"}
    }
  },
  "secrets": [{
    "name": "api_token", "title": "Jellyfin API key",
    "description": "在 Jellyfin 控制台的 API 密钥中创建；仅作为 X-Emby-Token 发往配置的实例",
    "required": true
  }],
  "permissions": {"network": []}
}
