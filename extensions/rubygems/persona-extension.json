{
  "manifest_version": 1,
  "id": "rubygems",
  "name": "RubyGems",
  "version": "0.1.0",
  "description": "Search Ruby gems on the official RubyGems JSON API. Compare current versions, licenses, runtime dependencies, release dates, download activity, documentation and repository links. Get an exact-version gem install command without executing it.",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/rubygems/README.md",
  "tags": [
    "Development",
    "Ruby",
    "RubyGems",
    "Dependencies"
  ],
  "engines": {
    "plugin_protocol": 1
  },
  "runtime": {
    "mode": "deno",
    "source": {
      "entry": "src/index.ts",
      "bundle": "build/rubygems.mjs",
      "sha256": "f25ee50b00d69a7efab33bb40a738d07fda572ead885c4e34f812fa20cab0b38"
    }
  },
  "contributes": {
    "connectors": [
      {
        "id": "rubygems",
        "name": "RubyGems",
        "capabilities": [
          "status",
          "tools"
        ],
        "hosts": [
          "rubygems.org"
        ],
        "agent_tools": [
          "rubygems_*"
        ]
      }
    ],
    "ui": [
      {
        "id": "rubygems",
        "title": "RubyGems",
        "placement": "nav_page",
        "icon": "code"
      }
    ]
  },
  "permissions": {
    "network": [
      "rubygems.org"
    ]
  }
}
