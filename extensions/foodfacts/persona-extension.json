{
  "manifest_version": 1,
  "id": "foodfacts",
  "name": "食品商品查询",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "按商品名称或条码查询 Open Food Facts，查看品牌、配料、标称过敏原、营养等级和原始商品链接。众包信息可能不完整，过敏和饮食决策请以实际包装为准。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/foodfacts/README.md",
  "tags": [
    "食品",
    "配料",
    "Open Food Facts"
  ],
  "engines": {
    "plugin_protocol": 1
  },
  "runtime": {
    "mode": "deno",
    "source": {
      "entry": "src/index.ts",
      "bundle": "build/foodfacts.mjs",
      "sha256": "c9b896535b25300d0672993bc4ceb73ddbb1290df5283553778b0cac120e047c"
    }
  },
  "contributes": {
    "connectors": [
      {
        "id": "foodfacts",
        "name": "Open Food Facts",
        "capabilities": [
          "status",
          "tools"
        ],
        "hosts": [
          "world.openfoodfacts.org"
        ],
        "agent_tools": [
          "foodfacts_*"
        ]
      }
    ],
    "ui": [
      {
        "id": "products",
        "title": "食品商品查询",
        "placement": "nav_page",
        "icon": "search"
      }
    ]
  },
  "permissions": {
    "network": [
      "world.openfoodfacts.org"
    ]
  }
}
