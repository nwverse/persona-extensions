{
  "manifest_version": 1,
  "id": "linuxdo",
  "name": "LINUX DO",
  "version": "0.1.1",
  "description": "LINUX DO 社区的热门帖子：扩展里的一页按你的兴趣看热门、今日 / 本周最热和最新，点开在 App 里读正文和热门回复（hub 去读，手机不用代理）；助手能用工具查热门、读帖子。只读公开内容，不用账号。",
  "publisher": "nwverse",
  "engines": {
    "plugin_protocol": 1
  },
  "runtime": {
    "command": {
      "linux-amd64": "bin/linuxdo-linux-amd64",
      "linux-arm64": "bin/linuxdo-linux-arm64",
      "darwin-arm64": "bin/linuxdo-darwin-arm64",
      "darwin-amd64": "bin/linuxdo-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [
      {
        "id": "linuxdo",
        "name": "LINUX DO",
        "capabilities": [
          "status",
          "tools"
        ],
        "hosts": [
          "linux.do"
        ]
      }
    ],
    "ui": [
      {
        "id": "hot",
        "title": "热门帖子",
        "placement": "plugin_page"
      }
    ]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "list": {
        "type": "string",
        "title": "打开时看",
        "default": "hot",
        "oneOf": [
          {
            "const": "hot",
            "title": "热门"
          },
          {
            "const": "daily",
            "title": "今日最热"
          },
          {
            "const": "weekly",
            "title": "本周最热"
          },
          {
            "const": "latest",
            "title": "最新"
          }
        ]
      },
      "categories": {
        "type": "array",
        "title": "只看这些分类",
        "description": "分类名，如「开发调优」「前沿快讯」「资源荟萃」；空着看全部",
        "items": {
          "type": "string"
        }
      },
      "exclude_categories": {
        "type": "array",
        "title": "不看这些分类",
        "description": "如「搞七捻三」「跳蚤市场」",
        "items": {
          "type": "string"
        }
      },
      "keywords": {
        "type": "array",
        "title": "关键词",
        "description": "标题或摘要里有其中一个才显示（不分大小写）；空着不限",
        "items": {
          "type": "string"
        }
      },
      "exclude_keywords": {
        "type": "array",
        "title": "屏蔽词",
        "description": "标题或摘要里有其中一个就不显示",
        "items": {
          "type": "string"
        }
      },
      "hide_nsfw": {
        "type": "boolean",
        "title": "隐藏 NSFW",
        "default": true,
        "description": "标题里标了 NSFW 的不显示"
      },
      "hide_pinned": {
        "type": "boolean",
        "title": "隐藏置顶",
        "default": true,
        "description": "站务置顶的公告不显示（热门列表最前面常是几条很久以前的置顶）"
      },
      "tz": {
        "type": "string",
        "title": "时区",
        "description": "页面和工具里的时间用这个时区（如 Asia/Shanghai）；空着用 hub 机器的"
      }
    }
  },
  "permissions": {
    "network": [
      "linux.do"
    ]
  }
}
