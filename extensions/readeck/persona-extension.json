{
  "manifest_version": 1,
  "id": "readeck",
  "name": "Readeck 阅读",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "在 Persona 中搜索自托管 Readeck 阅读队列，阅读已保存的 Markdown 正文、笔记和划线，确认后收藏网页或更新阅读进度。API token 加密保存在 hub；远程服务要求 HTTPS，不删除书签，不公开分享文章。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/readeck/README.md",
  "tags": ["Readeck", "稍后阅读", "划线", "自托管"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/readeck-linux-amd64",
      "linux-arm64": "bin/readeck-linux-arm64",
      "darwin-arm64": "bin/readeck-darwin-arm64",
      "darwin-amd64": "bin/readeck-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{
      "id": "readeck", "name": "Readeck", "capabilities": ["status", "tools", "actions"],
      "hosts": [], "agent_tools": ["readeck_*"],
      "confirm_always": ["readeck_save_bookmark", "readeck_update_reading"]
    }],
    "ui": [{"id": "reading", "title": "Readeck 阅读", "placement": "nav_page", "icon": "doc"}]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "instance_url": {"type": "string", "title": "Readeck 实例地址", "description": "例如 https://readeck.example.com；仅本机允许 HTTP，会自动追加 /api", "format": "uri"}
    }
  },
  "secrets": [{
    "name": "api_token", "title": "Readeck API token",
    "description": "在 Readeck 个人资料的 API 令牌页面创建；仅作为 Bearer 令牌发往配置的实例",
    "required": true
  }],
  "permissions": {"network": []}
}
