{
  "manifest_version": 1,
  "id": "asana",
  "name": "Asana 任务",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "在 Persona 里处理 Asana 个人任务：选择工作区，查看分配给自己的任务、截止日期、项目和备注；创建任务或标记完成前在手机上确认。个人访问令牌加密存在 hub，不删除任务，不管理工作区。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/asana/README.md",
  "tags": ["Asana", "任务", "待办", "项目管理"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/asana-linux-amd64",
      "linux-arm64": "bin/asana-linux-arm64",
      "darwin-arm64": "bin/asana-darwin-arm64",
      "darwin-amd64": "bin/asana-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{
      "id": "asana", "name": "Asana", "capabilities": ["status", "tools", "actions"],
      "hosts": ["app.asana.com"], "agent_tools": ["asana_*"],
      "confirm_always": ["asana_create_task", "asana_complete_task"]
    }],
    "ui": [{"id": "tasks", "title": "Asana 任务", "placement": "nav_page", "icon": "check"}]
  },
  "configuration": {"type": "object", "properties": {}},
  "secrets": [{
    "name": "access_token", "title": "Asana 个人访问令牌",
    "description": "在 Asana 的个人访问令牌设置中创建；只作为 Bearer 令牌发往 app.asana.com",
    "required": true
  }],
  "permissions": {"network": ["app.asana.com"]}
}
