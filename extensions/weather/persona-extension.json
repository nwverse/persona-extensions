{
  "manifest_version": 1,
  "id": "weather",
  "name": "天气",
  "version": "0.3.0",
  "icon": "assets/icon.png",
  "description": "天气（Open-Meteo，免费、不用 key）：当前天气、未来 24 小时气温、7 天预报和空气质量；欧洲花粉季可看桤木、桦木、禾草、艾蒿、橄榄、豚草的小时浓度和空气质量趋势。设了多个城市可切换。助手可查当前天气、预报、空气质量和花粉。只读公开数据，不用账号。",
  "publisher": "nwverse",
  "tags": ["天气", "预报", "空气质量", "花粉"],
  "engines": {
    "plugin_protocol": 1
  },
  "runtime": {
    "command": {
      "linux-amd64": "bin/weather-linux-amd64",
      "linux-arm64": "bin/weather-linux-arm64",
      "darwin-arm64": "bin/weather-darwin-arm64",
      "darwin-amd64": "bin/weather-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [
      {
        "id": "weather",
        "name": "天气",
        "capabilities": [
          "status",
          "tools"
        ],
        "hosts": [
          "api.open-meteo.com",
          "air-quality-api.open-meteo.com",
          "geocoding-api.open-meteo.com"
        ]
      }
    ],
    "ui": [
      {
        "id": "weather",
        "title": "天气",
        "placement": "nav_page",
        "icon": "gauge"
      },
      {
        "id": "page",
        "title": "天气",
        "placement": "plugin_page"
      }
    ]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "cities": {
        "type": "array",
        "title": "城市",
        "description": "要看天气的城市，第一个是默认。每项写一个城市名（如 上海、Tokyo），按 Open-Meteo 的地名搜索取第一个结果；重名的在名字后写上「纬度,经度」，如「Springfield 39.80,-89.64」。默认是上海。",
        "default": ["上海"],
        "maxItems": 8,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "temperature_unit": {
        "type": "string",
        "title": "温度单位",
        "default": "celsius",
        "oneOf": [
          {
            "const": "celsius",
            "title": "摄氏度（℃）"
          },
          {
            "const": "fahrenheit",
            "title": "华氏度（℉）"
          }
        ]
      },
      "wind_unit": {
        "type": "string",
        "title": "风速单位",
        "default": "kmh",
        "oneOf": [
          {
            "const": "kmh",
            "title": "千米/时（km/h）"
          },
          {
            "const": "ms",
            "title": "米/秒（m/s）"
          }
        ]
      }
    }
  },
  "permissions": {
    "network": [
      "api.open-meteo.com",
      "air-quality-api.open-meteo.com",
      "geocoding-api.open-meteo.com"
    ]
  }
}
