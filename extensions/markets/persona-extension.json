{
  "manifest_version": 1,
  "id": "markets",
  "name": "行情",
  "version": "0.4.0",
  "description": "行情（加密货币来自 OKX 公开行情接口，A 股、港股、美股来自腾讯行情的网页接口，都不用账号）：主导航上多一个「行情」，搜币、搜股票，看自选的价格和涨跌，点开看 K 线走势和成交量；助手能用工具搜代码、查报价和 K 线。hub 去读，手机不用代理。",
  "publisher": "nwverse",
  "tags": ["行情", "加密货币", "OKX", "A股", "港股", "美股"],
  "engines": {
    "plugin_protocol": 1
  },
  "runtime": {
    "command": {
      "linux-amd64": "bin/markets-linux-amd64",
      "linux-arm64": "bin/markets-linux-arm64",
      "darwin-arm64": "bin/markets-darwin-arm64",
      "darwin-amd64": "bin/markets-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [
      {
        "id": "markets",
        "name": "行情",
        "capabilities": [
          "status",
          "tools"
        ],
"hosts": [
          "www.okx.com",
          "qt.gtimg.cn",
          "smartbox.gtimg.cn",
          "web.ifzq.gtimg.cn",
          "ifzq.gtimg.cn"
        ]
      }
    ],
    "ui": [
      {
        "id": "watchlist",
        "title": "行情",
        "placement": "nav_page",
        "icon": "chart"
      },
      {
        "id": "card",
        "title": "行情",
        "placement": "overview_card",
        "opens": "watchlist"
      }
    ]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "watchlist": {
        "type": "array",
        "title": "初始自选",
        "description": "第一次打开时的自选。OKX 的交易对直接写，如 BTC-USDT、BTC-USDT-SWAP，只写币名（BTC）当成对 USDT；股票在代码前写市场，如 cn:600519、hk:00700、us:AAPL。之后在「行情」页里加减",
        "items": {
          "type": "string"
        }
      },
      "bar": {
        "type": "string",
        "title": "K 线默认周期",
        "description": "来源没有这个周期时用它最接近 1 小时的",
        "default": "1H",
        "oneOf": [
          {
            "const": "T",
            "title": "今日分时（股票）"
          },
          {
            "const": "15m",
            "title": "15 分钟"
          },
          {
            "const": "1H",
            "title": "1 小时"
          },
          {
            "const": "4H",
            "title": "4 小时"
          },
          {
            "const": "1D",
            "title": "1 天"
          },
          {
            "const": "1W",
            "title": "1 周"
          }
        ]
      },
      "overview_card": {
        "type": "boolean",
        "title": "总览卡片",
        "description": "在总览上放一张行情卡片：BTC、上证指数、恒生指数、纳斯达克，和自选里涨跌最多的几个，点开进「行情」。关掉就不显示",
        "default": true
      },
      "colors": {
        "type": "string",
        "title": "涨跌颜色",
        "default": "red_up",
        "oneOf": [
          {
            "const": "red_up",
            "title": "红涨绿跌"
          },
          {
            "const": "green_up",
            "title": "绿涨红跌"
          }
        ]
      },
      "tz": {
        "type": "string",
        "title": "时区",
        "description": "K 线横轴的时间用这个时区（如 Asia/Shanghai）；空着用 App 的"
      }
    }
  },
  "permissions": {
"network": [
      "www.okx.com",
      "qt.gtimg.cn",
      "smartbox.gtimg.cn",
      "web.ifzq.gtimg.cn",
      "ifzq.gtimg.cn"
    ]
  }
}
