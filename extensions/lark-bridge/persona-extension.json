{
  "manifest_version": 1,
  "id": "lark-bridge",
  "name": "Lark Bridge",
  "version": "0.1.0",
  "icon": "assets/icon.png",
  "description": "Read Lark chats, messages, contacts and documents through the existing host-managed lark-cli sign-in. No second login, arbitrary commands or message writes.",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/tree/main/extensions/lark-bridge",
  "tags": [
    "Lark",
    "Feishu",
    "messages",
    "documents",
    "read-only"
  ],
  "engines": {
    "persona": ">=202611111551",
    "extension_protocol": 1
  },
  "runtime": {
    "mode": "deno",
    "source": {
      "entry": "src/index.ts",
      "bundle": "build/lark-bridge.mjs",
      "sha256": "b7f6e31dd6be70684c389848ec696ce262b1c98525e6b21cd854ead015a93832"
    }
  },
  "host_integrations": [
    {
      "id": "lark-cli",
      "version": ">=1.0.72 <2.0.0"
    }
  ],
  "contributes": {
    "connectors": [
      {
        "id": "larkbridge",
        "name": "Lark Bridge",
        "capabilities": [
          "status",
          "tools"
        ],
        "agent_tools": [
          "larkbridge_chats",
          "larkbridge_messages",
          "larkbridge_search",
          "larkbridge_docs"
        ]
      }
    ],
    "ui": [
      {
        "id": "larkbridge",
        "title": "Lark Bridge",
        "placement": "nav_page",
        "icon": "chat"
      }
    ]
  }
}
