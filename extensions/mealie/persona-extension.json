{
  "manifest_version": 1,
  "id": "mealie",
  "name": "Mealie 菜谱",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "在 Persona 中搜索自托管 Mealie 菜谱库，阅读食材、步骤和原始来源，确认后从公开网页 URL 导入菜谱。API token 加密保存在 hub；实例要求 HTTPS，导入 URL 不包含内网或本机地址，不修改购物清单或家庭权限。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/mealie/README.md",
  "tags": ["Mealie", "菜谱", "食材", "自托管"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/mealie-linux-amd64",
      "linux-arm64": "bin/mealie-linux-arm64",
      "darwin-arm64": "bin/mealie-darwin-arm64",
      "darwin-amd64": "bin/mealie-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{
      "id": "mealie", "name": "Mealie", "capabilities": ["status", "tools", "actions"],
      "hosts": [], "agent_tools": ["mealie_*"],
      "confirm_always": ["mealie_import_recipe"]
    }],
    "ui": [{"id": "recipes", "title": "Mealie 菜谱", "placement": "nav_page", "icon": "doc"}]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "instance_url": {"type": "string", "title": "Mealie 实例地址", "description": "例如 https://mealie.example.com；仅本机允许 HTTP，会自动追加 /api", "format": "uri"}
    }
  },
  "secrets": [{
    "name": "api_token", "title": "Mealie API token",
    "description": "在 Mealie 个人资料的 API 令牌中创建；仅作为 Bearer 令牌发往配置的实例",
    "required": true
  }],
  "permissions": {"network": []}
}
