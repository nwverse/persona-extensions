{
  "manifest_version": 1,
  "id": "spaces",
  "name": "空间",
  "version": "0.1.0",
  "description": "按你的想法组织数据的空间：每个空间由你或助手定义类型（字段、状态、呈现方式），记录和它们之间的关系存在一处，页面直接由这些结构生成——列表、看板、进度、表格或动态流。附带本机 MCP 服务器（spaces mcp），助手能在对话里搭结构、读写记录，只读查询直接运行，写入按对话的权限询问。数据只在扩展自己的数据目录，不联网，不需要密钥。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/docs/extensions/spaces.md",
  "tags": ["空间", "本体", "结构化", "知识库"],
  "engines": {"extension_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/spaces-linux-amd64",
      "linux-arm64": "bin/spaces-linux-arm64",
      "darwin-amd64": "bin/spaces-darwin-amd64",
      "darwin-arm64": "bin/spaces-darwin-arm64"
    }
  },
  "contributes": {
    "ui": [
      {"id": "spaces", "title": "空间", "placement": "nav_page", "icon": "folder"},
      {"id": "spaces-card", "title": "空间", "placement": "overview_card", "opens": "spaces"}
    ],
    "skills": [
      {"id": "spaces", "dir": "skills/spaces"}
    ],
    "mcp_servers": [
      {
        "id": "spaces",
        "command": "spaces",
        "env": "PERSONA_SPACES_BIN",
        "args": ["mcp"],
        "requires": ["mcp"],
        "allow": ["space_list", "space_schema_get", "space_query"]
      }
    ]
  }
}
