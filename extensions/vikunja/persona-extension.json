{
  "manifest_version": 1,
  "id": "vikunja",
  "name": "Vikunja 任务",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "在 Persona 中查看 Vikunja 分配给自己的未完成任务、搜索任务、阅读描述和评论，确认后在项目内创建任务或标记完成。API token 加密保存在 hub；自托管服务要求 HTTPS，不删除任务、不修改成员或项目权限。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/vikunja/README.md",
  "tags": ["Vikunja", "任务", "项目", "自托管"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/vikunja-linux-amd64",
      "linux-arm64": "bin/vikunja-linux-arm64",
      "darwin-arm64": "bin/vikunja-darwin-arm64",
      "darwin-amd64": "bin/vikunja-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{
      "id": "vikunja", "name": "Vikunja", "capabilities": ["status", "tools", "actions"],
      "hosts": [], "agent_tools": ["vikunja_*"],
      "confirm_always": ["vikunja_create_task", "vikunja_complete_task"]
    }],
    "ui": [{"id": "tasks", "title": "Vikunja 任务", "placement": "nav_page", "icon": "doc"}]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "instance_url": {"type": "string", "title": "Vikunja 实例地址", "description": "例如 https://vikunja.example.com；仅本机允许 HTTP，会自动追加 /api/v1", "format": "uri"}
    }
  },
  "secrets": [{
    "name": "api_token", "title": "Vikunja API token",
    "description": "在 Vikunja 个人设置的 API 令牌中创建；仅作为 Bearer 令牌发往配置的实例",
    "required": true
  }],
  "permissions": {"network": []}
}
