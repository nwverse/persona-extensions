{
  "manifest_version": 1,
  "id": "lobsters",
  "name": "Lobsters 技术阅读",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "在 Persona 里读 Lobsters 技术社区：热门和最新，按标签、作者和关键词筛选，看原文链接与嵌套讨论。公开内容只读，不用账号，不自动抓取第三方文章。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/lobsters/README.md",
  "tags": ["Lobsters", "技术", "阅读", "社区"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/lobsters-linux-amd64",
      "linux-arm64": "bin/lobsters-linux-arm64",
      "darwin-arm64": "bin/lobsters-darwin-arm64",
      "darwin-amd64": "bin/lobsters-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{"id": "lobsters", "name": "Lobsters", "capabilities": ["status", "tools"], "hosts": ["lobste.rs"], "agent_tools": ["lobsters_*"]}],
    "ui": [{"id": "stories", "title": "技术阅读", "placement": "nav_page", "icon": "list"}]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "tags": {"type": "array", "title": "关注的标签", "description": "只显示有其中任一标签的帖子；空着不限", "items": {"type": "string"}},
      "exclude_tags": {"type": "array", "title": "屏蔽的标签", "description": "有其中任一标签就不显示", "items": {"type": "string"}},
      "min_score": {"type": "integer", "title": "最低分数", "description": "0 不限", "minimum": 0, "default": 0}
    }
  },
  "permissions": {"network": ["lobste.rs"]}
}
