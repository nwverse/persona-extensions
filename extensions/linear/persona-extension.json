{
  "manifest_version": 1,
  "id": "linear",
  "name": "Linear 工作项",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "在 Persona 里处理 Linear 工作：分配给我的进行中事项，按团队的工作流看状态和优先级，读详情与讨论；新建、修改状态/负责人和发评论前在手机上确认。个人 API key 加密存在 hub，不执行任意 GraphQL。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/linear/README.md",
  "tags": ["Linear", "项目", "工作项", "研发"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/linear-linux-amd64",
      "linux-arm64": "bin/linear-linux-arm64",
      "darwin-arm64": "bin/linear-darwin-arm64",
      "darwin-amd64": "bin/linear-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{
      "id": "linear", "name": "Linear", "capabilities": ["status", "tools", "actions"],
      "hosts": ["linear.app"], "agent_tools": ["linear_*"],
      "confirm_always": ["linear_create", "linear_update", "linear_comment"]
    }],
    "ui": [{"id": "issues", "title": "工作项", "placement": "nav_page", "icon": "list"}]
  },
  "secrets": [{
    "name": "api_key", "title": "Linear 个人 API Key",
    "description": "在 Linear 的 Security & access 设置中创建；只作为 Authorization 认证头发往 api.linear.app",
    "required": true
  }],
  "permissions": {"network": ["api.linear.app"]}
}
