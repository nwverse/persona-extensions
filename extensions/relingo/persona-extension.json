{
  "manifest_version": 1,
  "id": "relingo",
  "name": "Relingo",
  "version": "0.2.0",
  "replaces": "termwise",
  "icon": "assets/icon.png",
  "description": "阅读页的两种模式：翻译模式保留原文并附上译文；生词模式像划词记忆一样给词加下划线，点开可看释义并记下。记下的词写在扩展自己的数据目录里。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/docs/extensions/relingo.md",
  "tags": ["阅读", "翻译", "生词", "英语"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/relingo-linux-amd64",
      "linux-arm64": "bin/relingo-linux-arm64",
      "darwin-arm64": "bin/relingo-darwin-arm64",
      "darwin-amd64": "bin/relingo-darwin-amd64"
    }
  },
  "contributes": {
    "ui": [
      {"id": "read", "title": "阅读", "placement": "plugin_page"}
    ],
    "text_lookup": [
      {"id": "relingo", "name": "Relingo", "languages": ["en"]}
    ]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "underline_saved": {
        "type": "boolean",
        "default": false,
        "title": "在 App 里给记下的词加下划线",
        "description": "打开后，App 里显示的英文中，你记下的词会带一条下划线。默认关闭。"
      }
    }
  },
  "permissions": {
    "network": ["api.mymemory.translated.net"]
  }
}
