{
  "manifest_version": 1,
  "id": "orca-bot",
  "name": "Orca 机器人",
  "version": "0.1.0",
  "icon": "assets/icon.png",
  "description": "把符合条件的新待办交给你 Mac 上 Orca 里的一个机器人：每条待办开一个新对话，让它先做准备（调研、拆解、起草）。机器人这一轮做完时 Persona 通知你，回答留在它的 Orca 对话里。机器人可以通过本扩展附带的 MCP 工具读到交给它的待办，并把准备结果写回到那条待办上；别的待办它碰不到。只走那台 Mac 上 Orca 的本地 socket，不经过 Orca Cloud。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/docs/extensions/orca-bot.md",
  "tags": ["Orca", "机器人", "待办", "MCP", "agents"],
  "engines": {"persona": ">=202611092100", "extension_protocol": 1},
  "activation_events": ["on_startup"],
  "runtime": {
    "command": {
      "linux-amd64": "bin/orca-bot-linux-amd64",
      "linux-arm64": "bin/orca-bot-linux-arm64",
      "darwin-arm64": "bin/orca-bot-darwin-arm64",
      "darwin-amd64": "bin/orca-bot-darwin-amd64"
    },
    "args": ["hub"]
  },
  "node": {
    "command": {
      "darwin-arm64": "bin/orca-bot-darwin-arm64",
      "darwin-amd64": "bin/orca-bot-darwin-amd64"
    },
    "args": ["node"],
    "machines": "machines",
    "permissions": {"files": true}
  },
  "contributes": {
    "ui": [
      {"id": "bot", "title": "Orca 机器人", "placement": "extension_page"}
    ],
    "events": [
      {"id": "todos", "subscribe": ["todo.changed"]}
    ]
  },
  "permissions": {
    "hub": ["todos.read", "todos.write", "notify"]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "machines": {
        "type": "array",
        "title": "运行 Orca 的 Mac",
        "description": "选一台开着 Orca 的 Mac。机器人在本扩展的「Orca 机器人」页里从这台 Mac 上 Orca 的机器人列表中选。",
        "items": {"type": "string", "format": "machine", "x-os": ["darwin"]},
        "maxItems": 1,
        "x-confirm": "Persona 会在这台 Mac 上运行 Orca 机器人扩展的程序：通过 Orca 的本地 socket 读取机器人列表，为每条转来的待办给你选的机器人开一个新对话并发一条消息，再读取这个对话是否做完。它还在自己的数据目录里放一个 MCP 命令，供你登记为机器人的工具。"
      },
      "project": {
        "type": "string",
        "title": "只转发这个项目里的待办",
        "description": "知识库项目的 slug（待办详情里的「项目」）。空着表示不按项目筛选。项目和关键词至少填一个，否则什么都不转发；两个都填时，两个条件都要满足。",
        "maxLength": 200,
        "default": ""
      },
      "keywords": {
        "type": "array",
        "title": "标题或备注里含这些词的待办",
        "description": "含任意一个词就算符合，不区分大小写。空着表示不按关键词筛选。",
        "items": {"type": "string", "minLength": 1, "maxLength": 100},
        "maxItems": 20,
        "default": []
      }
    }
  }
}
