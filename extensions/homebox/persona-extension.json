{
  "manifest_version": 1,
  "id": "homebox",
  "name": "Homebox 物品库",
  "version": "0.1.1",
  "icon": "assets/icon.png",
  "description": "在 Persona 中搜索 Homebox 家庭物品、序列号、型号、保修和存放位置，确认后按已有类型、位置和标签登记新物品。API token 加密保存在 hub；自托管服务要求 HTTPS，不删除物品、不上传附件、不管理家庭组。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/homebox/README.md",
  "tags": ["Homebox", "物品管理", "保修", "自托管"],
  "engines": {"plugin_protocol": 1},
  "runtime": {
    "command": {
      "linux-amd64": "bin/homebox-linux-amd64",
      "linux-arm64": "bin/homebox-linux-arm64",
      "darwin-arm64": "bin/homebox-darwin-arm64",
      "darwin-amd64": "bin/homebox-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [{
      "id": "homebox", "name": "Homebox", "capabilities": ["status", "tools", "actions"],
      "hosts": [], "agent_tools": ["homebox_*"],
      "confirm_always": ["homebox_create_item"]
    }],
    "ui": [{"id": "inventory", "title": "Homebox 物品库", "placement": "nav_page", "icon": "doc"}]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "instance_url": {"type": "string", "title": "Homebox 实例地址", "description": "例如 https://homebox.example.com；仅本机允许 HTTP，会自动追加 /api", "format": "uri"}
    }
  },
  "secrets": [{
    "name": "api_token", "title": "Homebox API token",
    "description": "在 Homebox 个人资料的 API 密钥中创建；仅作为 Bearer 令牌发往配置的实例",
    "required": true
  }],
  "permissions": {"network": []}
}
