{
  "manifest_version": 1,
  "id": "wiktionary",
  "name": "Wiktionary 多语词典",
  "version": "0.1.3",
  "icon": "assets/icon.png",
  "description": "查询英文、中文和日文 Wiktionary 的词性、释义与例句，提供原始条目链接。内容由 hub 通过公开 API 获取，无需账号。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/blob/main/extensions/wiktionary/README.md",
  "tags": [
    "词典",
    "语言",
    "Wiktionary"
  ],
  "engines": {
    "plugin_protocol": 1
  },
  "runtime": {
    "mode": "deno",
    "source": {
      "entry": "src/index.ts",
      "bundle": "build/wiktionary.mjs",
      "sha256": "604ed383436a9992a741989f8110635c25fb7026ef299149e8311844ce31d7ce"
    }
  },
  "contributes": {
    "connectors": [
      {
        "id": "wiktionary",
        "name": "Wiktionary",
        "capabilities": [
          "status",
          "tools"
        ],
        "hosts": [
          "en.wiktionary.org",
          "zh.wiktionary.org",
          "ja.wiktionary.org"
        ],
        "agent_tools": [
          "wiktionary_*"
        ]
      }
    ],
    "ui": [
      {
        "id": "lookup",
        "title": "查词典",
        "placement": "nav_page",
        "icon": "doc"
      }
    ]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "language": {
        "type": "string",
        "title": "Wiktionary 语言",
        "default": "auto",
        "description": "auto 跟随 Persona 界面语言；英文选 en，中文选 zh，日文选 ja",
        "oneOf": [
          {
            "const": "auto",
            "title": "跟随界面语言"
          },
          {
            "const": "en",
            "title": "English"
          },
          {
            "const": "zh",
            "title": "中文"
          },
          {
            "const": "ja",
            "title": "日本語"
          }
        ]
      }
    }
  },
  "permissions": {
    "network": [
      "en.wiktionary.org",
      "zh.wiktionary.org",
      "ja.wiktionary.org"
    ]
  }
}
