{
  "manifest_version": 1,
  "id": "example-capsule",
  "name": "Capsule Example",
  "version": "1.0.0",
  "engines": {"extension_protocol": 1},
  "runtime": {"command": "bin/example-capsule", "rpc": "stdio"},
  "contributes": {"ui": [
    {"id": "home", "title": "任务详情", "placement": "extension_page"},
    {"id": "task", "title": "任务状态", "placement": "capsule_card", "opens": "home"}
  ]}
}
