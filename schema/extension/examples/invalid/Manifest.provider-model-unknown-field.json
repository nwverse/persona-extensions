{
  "manifest_version": 1,
  "id": "example-provider",
  "name": "Example Provider",
  "version": "1.0.0",
  "contributes": {
    "providers": [
      {
        "id": "example",
        "name": "Example",
        "kind": "api",
        "api": "messages",
