              "header": "@@ -0,0 +1,12 @@",
              "old_start": 0,
              "new_start": 1,
              "lines": [
                "+package upload",
                "+",
                "+import \"time\"",
                "+",
                "+// Retry calls f until it succeeds or attempts run out.",
                "+func Retry(attempts int, f func() error) error {",
                "+\tvar err error",
                "+\tfor i := 0; i < attempts; i++ {",
                "+\t\tif err = f(); err == nil {",
                "+\t\t\treturn nil",
                "+\t\t}",
                "+\t\ttime.Sleep(time.Duration(i) * time.Second)"
              ]
            }
          ],
          "threads": [
