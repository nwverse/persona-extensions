{
  "market_version": 1,
  "name": "nwverse 扩展",
  "description": "nwverse 维护、以后可以公开的 Persona 扩展。",
  "plugins": [
    {
      "manifest": {
        "manifest_version": 1,
        "id": "claude-bypass-allow",
        "name": "Bypass 自动允许",
        "version": "0.2.10",
        "description": "Claude Code 开着 bypassPermissions（--dangerously-skip-permissions）时，有些调用仍会弹确认框（如读工作目录外的文件、开子 Agent、某些 Bash），无人值守的 Agent 就卡在「在等你」。在你选的电脑上给 Claude Code 装一个 PermissionRequest hook：只在会话是 bypass 模式时，自动允许 Bash、只读工具（Read、Glob、Grep、LS、NotebookRead）和子 Agent。删除、覆盖数据、force push、改权限的 Bash 命令，写文件、Workflow 和 MCP 工具，以及你自己配的 ask / deny 规则，仍然问你。每次自动允许都记一条（命令截断、去掉密钥）。别的模式照常问你。",
        "publisher": "nwverse",
        "homepage": "https://github.com/nwverse/persona-extensions/tree/main/extensions/claude-bypass-allow",
        "engines": {
          "persona": ">=202611041602",
          "extension_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/claude-bypass-allow-linux-amd64",
            "linux-arm64": "bin/claude-bypass-allow-linux-arm64",
            "darwin-arm64": "bin/claude-bypass-allow-darwin-arm64",
            "darwin-amd64": "bin/claude-bypass-allow-darwin-amd64"
          },
          "args": [
            "hub"
          ]
        },
        "node": {
          "command": {
            "linux-amd64": "bin/claude-bypass-allow-linux-amd64",
            "linux-arm64": "bin/claude-bypass-allow-linux-arm64",
            "darwin-arm64": "bin/claude-bypass-allow-darwin-arm64",
            "darwin-amd64": "bin/claude-bypass-allow-darwin-amd64"
          },
          "args": [
            "node"
          ],
          "machines": "machines",
          "permissions": {
            "files": true
          }
        },
        "contributes": {
          "ui": [
            {
              "id": "log",
              "title": "自动允许记录",
              "placement": "extension_page"
            }
          ]
        },
        "configuration": {
          "type": "object",
          "properties": {
            "machines": {
              "type": "array",
              "title": "在哪些电脑上自动允许",
              "description": "打开的电脑上，Claude Code 的 settings.json 里会多一个 PermissionRequest hook；关掉、停用或卸载扩展时去掉。",
              "items": {
                "type": "string",
                "format": "machine",
                "x-os": [
                  "darwin",
                  "linux"
                ]
              },
              "x-confirm": "这台电脑上 bypass 模式的 Claude Code 会话，Bash、读文件（包括工作目录外的）和开子 Agent 的确认将不再问你、直接执行。删除、覆盖数据、force push、改权限仍然问你。每次都会记录。"
            },
            "config_dirs": {
              "type": "array",
              "title": "Claude Code 配置目录",
              "description": "装 hook 的目录，~ 是那台电脑的家目录。用了 CLAUDE_CONFIG_DIR 的把那个目录也加上。",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "maxItems": 8,
              "default": [
                "~/.claude"
              ]
            }
          }
        }
      },
      "tags": [
        "claude-code",
        "agents",
        "permissions"
      ],
      "packages": [
        {
          "url": "release:claude-bypass-allow-v0.2.10/claude-bypass-allow-0.2.10.tar.gz",
          "sha256": "861123afa4dcce0ec7fa461c418ec97a346e711a4c5a018902b1b841a381e254",
          "size": 12048590
        }
      ]
    },
    {
      "manifest": {
        "manifest_version": 1,
        "id": "github",
        "name": "GitHub",
        "version": "0.4.10",
        "description": "GitHub 进 Persona：收件箱里是请你 review、@ 你、指派给你、你的 PR / issue 有了新评论或 review、CI 失败；和你有关的 PR、issue 归档进知识库；助手能搜、读 PR / issue、看改动和 CI，评论和 review 先在手机上确认。登录用你某台电脑上的 gh 登录或设备码登录，token 加密存在 hub 的数据库里。侧边栏的「GitHub」页：待你 review 的 PR、你的 PR 和 CI、指派 / 提到你的、通知和关注的动态、你的仓库（浏览代码、分支、README），PR 的改动文件、逐文件 diff 和行内评论、全部评论、CI 日志摘要，在这一页上评论、review、合并（先预览、确认后才发）。",
        "publisher": "nwverse",
        "homepage": "https://github.com/nwverse/persona-extensions/tree/main/extensions/github",
        "engines": {
          "persona": ">=202611051346",
          "extension_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/github-linux-amd64",
            "linux-arm64": "bin/github-linux-arm64",
            "darwin-arm64": "bin/github-darwin-arm64",
            "darwin-amd64": "bin/github-darwin-amd64"
          }
        },
        "contributes": {
          "connectors": [
            {
              "id": "github",
              "name": "GitHub",
              "capabilities": [
                "status",
                "tools",
                "actions",
                "events",
                "inbox",
                "settle",
                "archive",
                "login",
                "options",
                "threads",
                "machines",
                "fallback"
              ],
              "hosts": [
                "github.com"
              ],
              "kinds": [
                "review_requested",
                "mention",
                "team_mention",
                "assign",
                "author",
                "ci_failed"
              ],
              "kind_descriptions": {
                "assign": "GitHub 上有 issue / PR 分配给了用户",
                "author": "用户自己的 PR / issue 有了别人的新评论或 review；要用户改代码、回答问题时需要用户，LGTM、批准、机器人消息知悉即可",
                "ci_failed": "用户触发的 GitHub Actions（CI）失败了",
                "mention": "GitHub 的 PR / issue 里 @ 了用户",
                "review_requested": "GitHub 上有人请用户 review 一个 PR（用户在 reviewers 里），一般需要用户",
                "team_mention": "GitHub 上 @ 了用户所在的团队（不是用户本人），多数知悉即可"
              }
            }
          ],
          "ui": [
            {
              "id": "github",
              "title": "GitHub",
              "placement": "nav_page",
              "icon": "list"
            }
          ]
        },
        "configuration": {
          "type": "object",
          "properties": {
            "triage_rules": {
              "type": "string",
              "title": "分拣规则",
              "maxLength": 4000,
              "description": "GitHub的条目按什么分「需要你 / 知悉即可 / 噪音」，用你自己的话写；填了就只用它、不用收件箱的全局规则（只管GitHub）。一般不在这里改：和助手说（比如「机器人的 PR 都算噪音」），它来改。写 \\n 换行；空着用全局规则"
            },
            "inbox": {
              "type": "object",
              "title": "收件箱",
              "description": "哪些 GitHub 通知进收件箱。改了以后只影响之后新来的：已经在收件箱里的条目不删、不改；不进收件箱的也不会推送。GitHub 页面、助手的 GitHub 工具照常能看所有仓库。整个 GitHub 都不进收件箱：关掉 GitHub 连接器的「进收件箱」（这一页上，或 设置 › 连接器 › GitHub）",
              "properties": {
                "repos": {
                  "type": "array",
                  "title": "只收这些仓库",
                  "description": "写 owner/name，或 owner/* 表示这个人或组织的全部仓库，不分大小写。空着收全部仓库",
                  "maxItems": 200,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.*?-]+/[A-Za-z0-9_.*?-]+$",
                    "maxLength": 200
                  }
                },
                "exclude_repos": {
                  "type": "array",
                  "title": "不收这些仓库",
                  "description": "写法同上（owner/name 或 owner/*），在「只收这些仓库」之后再排除",
                  "maxItems": 200,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.*?-]+/[A-Za-z0-9_.*?-]+$",
                    "maxLength": 200
                  }
                },
                "skip_kinds": {
                  "type": "array",
                  "title": "不收这些类型",
                  "description": "选中的类型不进收件箱。只想让它们排得低一点、不挡掉，写在上面的分拣规则里（比如「@ 团队的都算知悉」）；CI 失败只想少收一些（只看默认分支、只看自己的 PR），在 设置 › 连接器 › GitHub 的「CI 失败」里选",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "oneOf": [
                      {
                        "const": "review_requested",
                        "title": "请你 review"
                      },
                      {
                        "const": "mention",
                        "title": "@我"
                      },
                      {
                        "const": "team_mention",
                        "title": "@了你的团队"
                      },
                      {
                        "const": "assign",
                        "title": "分配给你"
                      },
                      {
                        "const": "author",
                        "title": "你的 PR / issue 有新动静"
                      },
                      {
                        "const": "ci_failed",
                        "title": "CI 失败"
                      }
                    ]
                  }
                }
              }
            },
            "host": {
              "type": "string",
              "title": "GitHub 主机",
              "default": "github.com",
              "description": "一般不用改。GitHub Enterprise 的主机名写在这里（还没做完：现在只认 github.com）"
            },
            "proxy": {
              "type": "string",
              "title": "代理",
              "description": "hub 这台机器连不上 GitHub 时填一个 http:// 代理（http://[用户名:密码@]主机:端口），登录、API、CI 日志都走它；填错了每个请求都失败，不会绕过它直连。空着直连"
            }
          }
        },
        "permissions": {
          "network": [
            "github.com",
            "api.github.com",
            "avatars.githubusercontent.com",
            "*.actions.githubusercontent.com",
            "*.blob.core.windows.net"
          ],
          "gh_login": true
        }
      },
      "tags": [
        "开发",
        "收件箱",
        "知识库"
      ],
      "packages": [
        {
          "url": "release:github-v0.4.10/github-0.4.10.tar.gz",
          "sha256": "3a262148106a1fef2f7d294c21a30eb804603bbb6b96a0a753b45405bfc78f6c",
          "size": 13543902
        }
      ]
    },
    {
      "manifest": {
        "manifest_version": 1,
        "id": "larkagentx",
        "name": "Feishu (LarkAgentX adapter)",
        "version": "0.1.5",
        "description": "独立的飞书个人账号适配器：用户自行在伴随机器上安装 LarkAgentX，hub 使用 Go 程序经 SSH 接入。只收双白名单内的文本消息，发送全文始终需要确认；不启动 Agent、不发已读回执，不替换 OpenLark。非官方协议，真实账号联调尚未验证。",
        "publisher": "nwverse",
        "homepage": "https://github.com/nwverse/persona-extensions/tree/main/extensions/larkagentx",
        "engines": {
          "persona": ">=202611041602",
          "plugin_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/larkagentx-linux-amd64",
            "linux-arm64": "bin/larkagentx-linux-arm64",
            "darwin-arm64": "bin/larkagentx-darwin-arm64",
            "darwin-amd64": "bin/larkagentx-darwin-amd64"
          }
        },
        "contributes": {
          "connectors": [
            {
              "id": "larkagentx",
              "name": "Feishu (LarkAgentX adapter)",
              "capabilities": [
                "status",
                "login",
                "inbox",
                "events",
                "actions"
              ],
              "confirm_always": [
                "larkagentx_send_text"
              ],
              "kinds": [
                "message"
              ],
              "kind_descriptions": {
                "message": "授权会话中授权发送者发来的飞书文本消息"
              }
            }
          ]
        },
        "configuration": {
          "type": "object",
          "properties": {
            "login_method": {
              "type": "string",
              "title": "登录方式",
              "enum": [
                "qr",
                "import"
              ],
              "default": "qr",
              "description": "qr 在 App 中扫码；import 通过隐藏字段导入上游登录态 JSON。"
            },
            "triage_rules": {
              "type": "string",
              "title": "分拣规则",
              "maxLength": 4000,
              "description": "飞书适配器的条目按什么分「需要你 / 知悉即可 / 噪音」；只对本扩展生效。写 \\n 换行；空着用全局规则。"
            },
            "bridge_command": {
              "type": "string",
              "title": "伴随机器命令（JSON 数组）",
              "maxLength": 8192,
              "description": "用户信任的 SSH 命令 argv；不经过本地 shell，不在参数中放凭证。见扩展文档。hub 不需要 Python。"
            },
            "allowed_chats": {
              "type": "string",
              "title": "授权会话 ID",
              "maxLength": 32768,
              "description": "逗号或换行分隔的精确 ID；不支持通配符，空白则禁止。发送也受此名单限制。"
            },
            "allowed_senders": {
              "type": "string",
              "title": "授权发送者 ID",
              "maxLength": 32768,
              "description": "逗号或换行分隔的精确 ID；收消息必须同时满足会话和发送者白名单，不接收自身回显。"
            }
          }
        }
      },
      "tags": [
        "feishu",
        "lark",
        "connector",
        "experimental"
      ],
      "packages": [
        {
          "url": "release:larkagentx-v0.1.5/larkagentx-0.1.5.tar.gz",
          "sha256": "75051b14d7e77017982d7e189ddd005fabbbe2f7ec47e506857b89cef93bf638",
          "size": 11957961
        }
      ]
    },
