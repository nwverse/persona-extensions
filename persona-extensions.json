{
  "market_version": 1,
  "name": "nwverse 扩展",
  "description": "nwverse 维护、以后可以公开的 Persona 扩展。",
  "extensions": [
    {
      "manifest": {
        "manifest_version": 1,
        "id": "linuxdo",
        "name": "LINUX DO",
        "version": "0.1.1",
        "description": "LINUX DO 社区的热门帖子：扩展里的一页按你的兴趣看热门、今日 / 本周最热和最新，点开在 App 里读正文和热门回复（hub 去读，手机不用代理）；助手能用工具查热门、读帖子。只读公开内容，不用账号。",
        "publisher": "nwverse",
        "engines": {
          "plugin_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/linuxdo-linux-amd64",
            "linux-arm64": "bin/linuxdo-linux-arm64",
            "darwin-arm64": "bin/linuxdo-darwin-arm64",
            "darwin-amd64": "bin/linuxdo-darwin-amd64"
          }
        },
        "contributes": {
          "connectors": [
            {
              "id": "linuxdo",
              "name": "LINUX DO",
              "capabilities": [
                "status",
                "tools"
              ],
              "hosts": [
                "linux.do"
              ]
            }
          ],
          "ui": [
            {
              "id": "hot",
              "title": "热门帖子",
              "placement": "plugin_page"
            }
          ]
        },
        "configuration": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string",
              "title": "打开时看",
              "default": "hot",
              "oneOf": [
                {
                  "const": "hot",
                  "title": "热门"
                },
                {
                  "const": "daily",
                  "title": "今日最热"
                },
                {
                  "const": "weekly",
                  "title": "本周最热"
                },
                {
                  "const": "latest",
                  "title": "最新"
                }
              ]
            },
            "categories": {
              "type": "array",
              "title": "只看这些分类",
              "description": "分类名，如「开发调优」「前沿快讯」「资源荟萃」；空着看全部",
              "items": {
                "type": "string"
              }
            },
            "exclude_categories": {
              "type": "array",
              "title": "不看这些分类",
              "description": "如「搞七捻三」「跳蚤市场」",
              "items": {
                "type": "string"
              }
            },
            "keywords": {
              "type": "array",
              "title": "关键词",
              "description": "标题或摘要里有其中一个才显示（不分大小写）；空着不限",
              "items": {
                "type": "string"
              }
            },
            "exclude_keywords": {
              "type": "array",
              "title": "屏蔽词",
              "description": "标题或摘要里有其中一个就不显示",
              "items": {
                "type": "string"
              }
            },
            "hide_nsfw": {
              "type": "boolean",
              "title": "隐藏 NSFW",
              "default": true,
              "description": "标题里标了 NSFW 的不显示"
            },
            "hide_pinned": {
              "type": "boolean",
              "title": "隐藏置顶",
              "default": true,
              "description": "站务置顶的公告不显示（热门列表最前面常是几条很久以前的置顶）"
            },
            "tz": {
              "type": "string",
              "title": "时区",
              "description": "页面和工具里的时间用这个时区（如 Asia/Shanghai）；空着用 hub 机器的"
            }
          }
        },
        "permissions": {
          "network": [
            "linux.do"
          ]
        }
      },
      "tags": [
        "社区",
        "热门",
        "阅读"
      ],
      "packages": [
        {
          "url": "release:linuxdo-v0.1.1/linuxdo-0.1.1.tar.gz",
          "sha256": "858ed2154b89c1fec152c40c9c0615f1eb657b8d0ef5cfb67495918c3cb05a5d",
          "size": 11895357
        }
      ]
    },
    {
      "manifest": {
        "manifest_version": 1,
        "id": "showcase",
        "name": "组件展示",
        "version": "0.1.0",
        "description": "扩展界面的每一种组件、每一种状态各一页：文字、数字、进度、行、按钮、链接、输入、图表、Markdown、表格、空状态、加载中；列表的搜索 / 筛选 / 加载更多，列表 → 详情 → 编辑 → 返回，invalidate；外加一张总览卡片、一个小组件和两个快捷指令。给写扩展的人看效果，也给各端做截图对齐。纯本地数据，不出网、不要密钥。",
        "publisher": "nwverse",
        "engines": {
          "extension_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/showcase-linux-amd64",
            "linux-arm64": "bin/showcase-linux-arm64",
            "darwin-amd64": "bin/showcase-darwin-amd64",
            "darwin-arm64": "bin/showcase-darwin-arm64"
          }
        },
        "contributes": {
          "ui": [
            {
              "id": "showcase",
              "title": "组件展示",
              "placement": "nav_page",
              "icon": "star"
            },
            {
              "id": "showcase-card",
              "title": "组件展示",
              "placement": "overview_card",
              "opens": "showcase"
            },
            {
              "id": "showcase-widget",
              "title": "组件展示",
              "placement": "widget",
              "families": [
                "small",
                "medium",
                "large",
                "accessory_circular",
                "accessory_rectangular",
                "accessory_inline"
              ],
              "refresh_minutes": 60,
              "opens": "showcase"
            }
          ],
          "shortcuts": [
            {
              "id": "showcase-echo",
              "title": "组件展示：说一句",
              "description": "把你写的话原样说回来",
              "params": [
                {
                  "name": "text",
                  "title": "说什么",
                  "kind": "text",
                  "required": true
                }
              ],
              "ui": "showcase"
            },
            {
              "id": "showcase-count",
              "title": "组件展示：数一数",
              "description": "按单位数到一个数，回一张结果卡片",
              "params": [
                {
                  "name": "n",
                  "title": "数到几",
                  "kind": "number",
                  "required": true
                },
                {
                  "name": "unit",
                  "title": "单位",
                  "kind": "choice",
                  "choices": [
                    {
                      "value": "apple",
                      "title": "苹果"
                    },
                    {
                      "value": "star",
                      "title": "星星"
                    }
                  ]
                },
                {
                  "name": "loud",
                  "title": "大声",
                  "kind": "toggle"
                }
              ]
            }
          ]
        }
      },
      "tags": [
        "示例",
        "开发"
      ],
      "packages": [
        {
          "url": "release:showcase-v0.1.0/showcase-0.1.0.tar.gz",
          "sha256": "5a2635aeb2ab9da24dbf7c3448efd01fbb2f4f5957ff2a725fe39f7b184ce386",
          "size": 11050745
        }
      ]
    },
    {
      "manifest": {
        "manifest_version": 1,
        "id": "starter-kit",
        "name": "入门套件",
        "version": "0.1.0",
        "description": "只有声明、不跑程序：一个周回顾技能、一段回答风格的说明、几条快捷提示、两份收件箱分拣规则模板和一个主题色。",
        "publisher": "nwverse",
        "engines": {
          "persona": ">=202611042338"
        },
        "contributes": {
          "skills": [
            {
              "id": "weekly-review",
              "dir": "skills/weekly-review"
            }
          ],
          "prompts": [
            {
              "id": "answer-style",
              "kind": "instructions",
              "file": "assistant/answer-style.md"
            },
            {
              "id": "today",
              "kind": "quick",
              "title": "今天做了什么",
              "text": "把我今天在各台电脑上做的事按项目整理成几行，每行一句话。"
            },
            {
              "id": "todo",
              "kind": "quick",
              "title": "整理待办",
              "text": "看一下我最近的收件箱和对话，列出还没做完、需要我决定的事，按急的先后排。"
            },
            {
              "id": "explain",
              "kind": "quick",
              "title": "讲给我听",
              "text": "用三五句话讲清楚这件事是什么、为什么重要、我接下来要做什么："
            }
          ],
          "triage_templates": [
            {
              "id": "mentions-only",
              "title": "群聊只看提到我的",
              "text": "私聊和提到我的群消息算要处理；需要我决定、回复或审批的算要处理。其余群聊消息、机器人通知、广播算知道就行；营销和自动订阅算噪音。"
            },
            {
              "id": "work-hours",
              "title": "工作和生活分开",
              "text": "工作相关、有截止时间、别人在等我回复的算要处理；家人朋友的私聊算要处理；新闻、推广、自动通知算知道就行；广告和重复的提醒算噪音。"
            }
          ],
          "themes": [
            {
              "id": "forest",
              "name": "森林",
              "light": {
                "accent": "#2E7D32",
                "positive": "#1B5E20"
              },
              "dark": {
                "accent": "#81C784",
                "positive": "#A5D6A7"
              }
            }
          ]
        }
      },
      "tags": [
        "入门",
        "助手",
        "收件箱",
        "主题"
      ],
      "packages": [
        {
          "url": "release:starter-kit-v0.1.0/starter-kit-0.1.0.tar.gz",
          "sha256": "f1ae884cd570c2b844e7d89005c831829dd1d60a55b2b49e4a61cf8db332eb53",
          "size": 2006
        }
      ]
    },
    {
      "manifest": {
        "manifest_version": 1,
        "id": "starter-pack",
        "name": "入门合集",
        "version": "0.1.0",
        "description": "一次装好入门套件和 LINUX DO 热门：扩展合集（extension_pack）的例子。",
        "publisher": "nwverse",
        "engines": {
          "persona": ">=202611042338"
        },
        "extension_pack": [
          {
            "id": "starter-kit"
          },
          {
            "id": "linuxdo"
          }
        ]
      },
      "tags": [
        "入门",
        "合集"
      ],
      "packages": [
        {
          "url": "release:starter-pack-v0.1.0/starter-pack-0.1.0.tar.gz",
          "sha256": "3fa824b5770fbc18cde31a4d9bdb3e4cc319decb9a911955aaa452f71f348abc",
          "size": 463
        }
      ]
    },
    {
      "manifest": {
        "manifest_version": 1,
        "id": "telegram",
        "name": "Telegram",
        "version": "0.1.3",
        "description": "用你自己的 Telegram 账号（MTProto，hub 直连 Telegram 的数据中心）：App 里的 Telegram 会话，收件箱（私聊、@我），知识库归档，助手的 Telegram 工具和 tg 命令行。发消息、回复、转发、点 reaction、标为已读都先在手机上确认。登录（api_id、api_hash 和会话）加密存在 hub 的数据库里，不在扩展目录。",
        "publisher": "nwverse",
        "engines": {
          "persona": ">=202611041602",
          "plugin_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/telegram-linux-amd64",
            "linux-arm64": "bin/telegram-linux-arm64",
            "darwin-arm64": "bin/telegram-darwin-arm64",
            "darwin-amd64": "bin/telegram-darwin-amd64"
          }
        },
        "contributes": {
          "connectors": [
            {
              "id": "telegram",
              "name": "Telegram",
              "capabilities": [
                "status",
                "tools",
                "actions",
                "events",
                "inbox",
                "archive",
                "login",
                "threads",
                "fallback"
              ],
              "unlisted": [
                "telegram_list_chats",
                "telegram_read_messages",
                "telegram_search_messages",
                "telegram_get_message",
                "telegram_get_chat",
                "telegram_list_members",
                "telegram_send",
                "telegram_forward",
                "telegram_react",
                "telegram_mark_read",
                "telegram_cli"
              ],
              "kinds": [
                "dm",
                "mention"
              ],
              "kind_descriptions": {
                "dm": "Telegram 里有人私聊用户，还没读",
                "mention": "Telegram 群里 @ 了用户，或回复了用户的消息"
              },
              "cli": "tg"
            }
          ],
          "assistant": [
            {
              "id": "telegram",
              "skills": [
                "skills/telegram"
              ]
            }
          ]
        },
        "configuration": {
          "type": "object",
          "properties": {
            "triage_rules": {
              "type": "string",
              "title": "分拣规则",
              "maxLength": 4000,
              "description": "Telegram 的条目按什么分「需要你 / 知悉即可 / 噪音」，用你自己的话写；填了就只用它（只管 Telegram）。一般不在这里改：和助手说（比如「Telegram 里陌生人的私聊都算噪音」），它来改。写 \\n 换行；空着时私聊和 @你 都算「需要你」，和以前一样"
            }
          }
        },
        "permissions": {
          "network": [
            "telegram.org",
            "*.telegram.org"
          ]
        }
      },
      "tags": [
        "聊天",
        "收件箱",
        "知识库"
      ],
      "packages": [
        {
          "url": "release:telegram-v0.1.3/telegram-0.1.3.tar.gz",
          "sha256": "96d121fdc58f13a2bcbcdaea8c5f9f57cbf914b6e9be7054553bcedee76d3454",
          "size": 21929958
        }
      ]
    }
  ],
